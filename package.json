{
  "name": "bench-supply",
  "version": "0.1.0",
  "private": true,
  "description": "Bench Supply — a learning-focused e-commerce store with Express, Postgres, and Drizzle.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "db:studio": "drizzle-kit studio",
    "test": "NODE_ENV=test node --test --test-concurrency=1 server/tests/",
    "test:watch": "NODE_ENV=test node --test --watch server/tests/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sloplint": "node scripts/sloplint.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
